# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Куда публиковать: @username канала или числовой id (-100...)
# Бот должен быть админом канала с правом публикации.
CHANNEL_ID=@my_news_channel

# Кому разрешено управлять ботом (свой id узнать у @userinfobot).
# Можно несколько через запятую.
ADMIN_IDS=123456789

# --- LLM: OpenRouter (настроено по умолчанию) ---
# Ключ: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=sk-or-v1-...

# Модель можно менять на ходу командой /setmodel, не трогая этот файл.
#
# DeepSeek на OpenRouter платный, но очень дешёвый (~22 ₽ за 1000 новостей
# на v4-flash). Бесплатных версий DeepSeek на OpenRouter сейчас нет.
# Другие варианты DeepSeek — дороже, но всё ещё копейки:
#   deepseek/deepseek-v3.2      ~40 ₽ / 1000 новостей
#   deepseek/deepseek-chat      ~52 ₽ / 1000 новостей
#   deepseek/deepseek-v4-pro    ~70 ₽ / 1000 новостей
#
# Если нужен именно нулевой счёт — есть бесплатные модели других вендоров
# (лимит запросов в сутки, качество для пересказа новостей приличное):
#   nvidia/nemotron-3-super-120b-a12b:free
#   google/gemma-4-31b-it:free
#   openai/gpt-oss-20b:free
# Актуальный список: https://openrouter.ai/models?max_price=0

# --- Альтернатива: DeepSeek напрямую ---
# Свой ключ на https://platform.deepseek.com (пробные кредиты, дальше оплата)
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

# Предупреждения о расходе лимита ИИ (70% и 90%) приходят в личку всем ADMIN_IDS.
# Пороги и суточный лимит настраиваются на ходу: /set alert_thresholds, /usage
#
# Отладка перед запуском в канал: /debug on — посты будут приходить в личку.

# --- Режим Claude (необязательно) ---
# Платная обработка через Claude вместо LLM_* выше, плюс несколько картинок
# со страницы новости в альбом вместо одной. Включается/выключается на ходу
# командой /claude on · /claude off — сюда только ключ и, по желанию, модель.
#
# Ключ: https://console.anthropic.com/settings/keys
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5
#
# Сколько картинок в альбом (1-10, по умолчанию 6): /set claude_max_images 6
# Учёт расхода лимита ИИ (/usage) на Claude не распространяется — это
# отдельный платный API со своим счётом на console.anthropic.com.

# --- VK (необязательно) ---
# Дублирование постов на стену сообщества. Пусто — публикуется только Telegram.
#
# Ключ: сообщество → Управление → Работа с API → Создать ключ,
# права «Стена» и «Фотографии». Ключ сообщества, не пользовательский.
# VK_TOKEN=vk1.a....
#
# Числовой id сообщества (не короткое имя): «Ещё» → «Статистика» — он будет
# в адресе, либо https://regvk.com/id/
# VK_GROUP_ID=123456789
#
# Картинки работают на этих двух ключах — ничего больше не нужно.
#
# VK_USER_TOKEN не обязателен. Прямую загрузку фото на стену VK ключу
# сообщества запрещает, поэтому бот грузит фото через сервер сообщений.
# Пользовательский ключ нужен, только если этот путь однажды перестанет
# работать; как его получить — в SETUP.md, раздел «Картинка в VK».
# VK_USER_TOKEN=vk1.a....
#
# Включение/выключение на ходу: /vk on, /vk off. Проверка ключей: /vk check.

# --- Прочее ---
DB_PATH=data/bot.db
LOG_LEVEL=INFO
